@page
@model WEB.Pages.IndexModel
@{
    ViewData["Title"] = "Tenants with Services";
}

<h2>Tenants with Services</h2>
<div class="mb-3">
    <button class="btn btn-success mb-2" 
        onclick="onnAddTenantForm()"
        id="addTenantButton">
        ➕ Add Tenant
    </button>
    <form method="post" asp-page-handler="Async">
        <div id="addTenantForm" class="card p-3 mb-3" style="display: none">
            <h4>Add New Tenant</h4>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.LastName" class="form-label">Last Name</label>
                <input asp-for="NewTenant.LastName" class="form-control" />
                <span asp-validation-for="NewTenant.LastName" class="text-danger"></span>
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.FirstName" class="form-label">First Name</label>
                <input asp-for="NewTenant.FirstName" class="form-control" />
                <span asp-validation-for="NewTenant.FirstName" class="text-danger"></span>
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.MiddleName" class="form-label">Middle Name</label>
                <input asp-for="NewTenant.MiddleName" class="form-control" />
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.Address" class="form-label">Address</label>
                <input asp-for="NewTenant.Address" class="form-control" />
                <span asp-validation-for="NewTenant.Address" class="text-danger"></span>
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.PersonalAccount" class="form-label">Personal Account</label>
                <input asp-for="NewTenant.PersonalAccount" class="form-control" />
                <span asp-validation-for="NewTenant.PersonalAccount" class="text-danger"></span>
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.ResidentsCount" class="form-label" >Residents Count</label>
                <input asp-for="NewTenant.ResidentsCount" type="number" class="form-control" lang="en"/>
                <span asp-validation-for="NewTenant.ResidentsCount" class="text-danger"></span>
            </div>
                
            <div class="mb-2">
                <label asp-for="NewTenant.ApartmentArea" class="form-label">Apartment Area (m²)</label>
                <input asp-for="NewTenant.ApartmentArea" type="number" step="0.01" class="form-control" lang="en"/>
                <span asp-validation-for="NewTenant.ApartmentArea" class="text-danger"></span>
            </div>
                
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">💾 Save</button>
                <button type="button" class="btn btn-secondary" 
                        onclick="onnAddTenantForm()">
                    ❌ Cancel
                </button>
            </div>
        </div>
    </form>
    
    <a asp-page="/Services" class="btn btn-success">➕ Add Service</a>
</div>

@foreach (var tenant in Model.Tenants)
{
    <div class="card mb-3 tenant-card" data-id="@tenant.Id">
        <div class="card-body">
            <input type="hidden" class="tenant-id" value="@tenant.Id" />

            <h4>
                <span class="view-mode">@tenant.LastName @tenant.FirstName @tenant.MiddleName</span>
                <div class="edit-mode d-none">
                    <input class="form-control tenant-lastname" value="@tenant.LastName" placeholder="Last Name" />
                    <input class="form-control tenant-firstname" value="@tenant.FirstName" placeholder="First Name" />
                    <input class="form-control tenant-middlename" value="@tenant.MiddleName" placeholder="Middle Name" />
                </div>
            </h4>

            <p>
                <strong>Address:</strong>
                <span class="view-mode">@tenant.Address</span>
                <input class="form-control edit-mode d-none tenant-address" value="@tenant.Address" />

                <br />

                <strong>Personal Account:</strong>
                <span class="view-mode">@tenant.PersonalAccount</span>
                <input class="form-control edit-mode d-none tenant-account" value="@tenant.PersonalAccount" />

                <br />

                <strong>Residents:</strong>
                <span class="view-mode">@tenant.ResidentsCount</span>
                <input type="number" class="form-control edit-mode d-none tenant-residents" value="@tenant.ResidentsCount" />

                <br />

                <strong>Apartment Area (m²):</strong>
                <span class="view-mode">@tenant.ApartmentArea</span>
                <input type="number" class="form-control edit-mode d-none tenant-area"
                       value="@tenant.ApartmentArea.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       step="0.01"
                       min="0"
                       lang="en" />
            </p>
            <td>
                <form method="post" asp-page-handler="AddService" class="mt-2">
                    <input type="hidden" name="tenantId" value="@tenant.Id" />
                    <input list="servicesList" name="serviceId" class="form-control" placeholder="Type part of Service Name" autocomplete="off" required />
                    <datalist id="servicesList">
                        @foreach (var service in Model.Services)
                        {
                            <option value="@service.Id">@service.ServiceName</option>
                        }
                    </datalist>
                    <button type="submit" class="btn btn-sm btn-primary mt-1">Add Service</button>
                </form>
            </td>

            <div class="actions">
                <button type="button" class="btn btn-warning btn-sm toggle-edit">✏️ Edit</button>
                <form asp-page-handler="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@tenant.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm"
                            onclick="return confirm('Ви впевнені, що хочете видалити цього мешканця?');">
                        🗑️ Delete
                    </button>
                </form>
                <button type="button" class="btn btn-success btn-sm save-tenant d-none">💾 Save</button>
                <button type="button" class="btn btn-secondary btn-sm cancel-edit d-none">❌ Cancel</button>
            </div>

            <table class="table table-sm table-bordered mt-3">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Billing Type</th>
                        <th>Tariff</th>
                        <th>Calculated Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var service in tenant.Services)
                    {
                        <tr>
                            <td>@service.ServiceName</td>
                            <td>@service.BillingType</td>
                            <td>@service.Tariff</td>
                            <td>@service.CalculatedAmount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const form = document.getElementById('addTenantForm');
        const addTenantButton =  document.getElementById('addTenantButton');
        $(document).on("click", ".toggle-edit", function () {
            let card = $(this).closest(".tenant-card");
            card.find(".view-mode").addClass("d-none");
            card.find(".edit-mode").removeClass("d-none");
            card.find(".toggle-edit").addClass("d-none");
            card.find(".save-tenant, .cancel-edit").removeClass("d-none");
        });

        $(document).on("click", ".cancel-edit", function () {
            let card = $(this).closest(".tenant-card");
            card.find(".view-mode").removeClass("d-none");
            card.find(".edit-mode").addClass("d-none");

            card.find(".toggle-edit").removeClass("d-none");
            card.find(".save-tenant, .cancel-edit").addClass("d-none");
        });

        $(document).on("click", ".save-tenant", function () {
            let card = $(this).closest(".tenant-card");

            let data = {
                Id: parseInt(card.find(".tenant-id").val()),
                LastName: card.find(".tenant-lastname").val(),
                FirstName: card.find(".tenant-firstname").val(),
                MiddleName: card.find(".tenant-middlename").val(),
                Address: card.find(".tenant-address").val(),
                PersonalAccount: card.find(".tenant-account").val(),
                ResidentsCount: parseInt(card.find(".tenant-residents").val()),
                ApartmentArea: parseFloat(card.find(".tenant-area").val())
            };

            console.log("Saving tenant:", data);

            // Створюємо FormData для відправки
            let formData = new FormData();
            formData.append("EditTenant.Id", data.Id);
            formData.append("EditTenant.LastName", data.LastName);
            formData.append("EditTenant.FirstName", data.FirstName);
            formData.append("EditTenant.MiddleName", data.MiddleName);
            formData.append("EditTenant.Address", data.Address);
            formData.append("EditTenant.PersonalAccount", data.PersonalAccount);
            formData.append("EditTenant.ResidentsCount", data.ResidentsCount);
            formData.append("EditTenant.ApartmentArea", data.ApartmentArea);

            fetch('?handler=Edit', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    return response.text();
                }
            })
            .then(() => {
                // Оновлюємо інтерфейс
                card.find(".view-mode").removeClass("d-none");
                card.find(".edit-mode").addClass("d-none");
                card.find(".toggle-edit").removeClass("d-none");
                card.find(".save-tenant, .cancel-edit").addClass("d-none");

                // Оновлюємо відображені дані
                card.find("h4 .view-mode").text(data.LastName + " " + data.FirstName + " " + (data.MiddleName || ""));
                card.find("p .view-mode").eq(0).text(data.Address);
                card.find("p .view-mode").eq(1).text(data.PersonalAccount);
                card.find("p .view-mode").eq(2).text(data.ResidentsCount);
                card.find("p .view-mode").eq(3).text(data.ApartmentArea);
            })
            .catch(error => {
                console.error("Error:", error);
                alert("❌ Помилка при збереженні даних");
            });
        });
        function onnAddTenantForm() {
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
            addTenantButton.style.display = form.style.display === 'none' ? 'block' : 'none';
        }
    </script>
}