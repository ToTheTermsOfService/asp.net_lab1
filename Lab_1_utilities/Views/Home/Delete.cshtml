@model Lab_1_utilities.Models.Tenant

@{
    ViewData["Title"] = "Delete Tenant";
}

<h2>Delete Tenant</h2>

<div class="alert alert-danger">
    <p>Are you sure you want to delete this tenant?</p>
</div>

<div class="card">
    <div class="card-body">
        <h4>@Model.LastName @Model.FirstName @Model.MiddleName</h4>
        <p>
            <strong>Address:</strong> @Model.Address <br />
            <strong>Personal Account:</strong> @Model.PersonalAccount <br />
            <strong>Residents:</strong> @Model.ResidentsCount <br />
            <strong>Apartment Area:</strong> @Model.ApartmentArea m²
        </p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger mt-3">Delete</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
