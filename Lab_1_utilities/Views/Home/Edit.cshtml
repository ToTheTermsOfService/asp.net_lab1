@model Lab_1_utilities.Models.Tenant

@{
    ViewData["Title"] = "Edit Tenant";
}

<h2>Edit Tenant</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="MiddleName"></label>
        <input asp-for="MiddleName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="PersonalAccount"></label>
        <input asp-for="PersonalAccount" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ResidentsCount"></label>
        <input asp-for="ResidentsCount" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="ApartmentArea"></label>
        <input asp-for="ApartmentArea" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>
